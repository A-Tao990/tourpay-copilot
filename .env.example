# Copy to .env (never commit .env). Sandbox credentials only - never use live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional AI brain. Leave empty to run on built-in rules. Priority: ANTHROPIC > GEMINI > LLM_BASE_URL.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Or any OpenAI-compatible server (e.g. a local llama.cpp / Ollama):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=local
PORT=8080
